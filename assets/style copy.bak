body,
html {
  overflow-y: auto;
  overflow-x: hidden;
  height: 100% !important;
  margin: 0;
  padding: 0;
  background-color: #c1c1c1;
}

.grid-container {
  display: grid;
  grid-template-areas:
    "header header header header header header"
    "menu main main main main main"
    "menu footer footer footer footer footer";
  gap: 10px;
  padding: 10px;
}

.grid-container > div {
  background-color: rgba(255, 255, 255, 1);
  box-shadow: 2px 2px 2px darkgray;
  border-radius: 5px;
}

.header {
  grid-area: header;
  padding: 20px 6px;
  text-align: center;
}

.menu {
  grid-area: menu;
  padding: 6px;
  text-align: left;
}

.main {
  grid-area: main;
}

.outputs {
  grid-area: footer;
  padding: 6px;
}
